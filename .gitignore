# Dependencies
node_modules/

# Build output
dist/
build/

# Credentials live in server/.env only — copy server/.env.example to start.
# The extension holds none by design, so there is no client-side env file.
# env.js is listed purely to catch a resurrected copy of the old leaked config.
env.js
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test + coverage output
coverage/
.nyc_output/
bench/results/

# Chrome extension packaging artifacts
*.pem
*.crx
web-ext-artifacts/

# Backup files — these are how credentials leaked the first time.
*.bak
*.old
*.backup
