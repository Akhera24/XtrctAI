{
  "name": "xtrct-proxy",
  "version": "2.0.0",
  "description": "Fault-tolerant proxy for the X API v2 — token-bucket rate limiting, circuit breaking, Redis caching, and request coalescing.",
  "main": "proxy.js",
  "scripts": {
    "start": "node proxy.js",
    "dev": "node --watch proxy.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "bench": "node bench/load.js"
  },
  "keywords": [
    "x-api",
    "twitter",
    "proxy",
    "rate-limiting",
    "token-bucket",
    "circuit-breaker",
    "redis"
  ],
  "author": "Aman Khera",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
