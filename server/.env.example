# Copy to server/.env and fill in. server/.env is gitignored — keep it that way.
#
# This file is the ONLY place X credentials should ever live. The extension holds
# none: anything shipped in a browser bundle can be extracted by whoever installs
# it, so the proxy is the trust boundary.

# ─── Required ────────────────────────────────────────────────────────────────

# Bearer token from https://developer.x.com/en/portal/dashboard
# The app MUST be attached to a Project, or API v2 returns 403 client-not-enrolled.
X_BEARER_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Redis is an optimization, not a dependency — the proxy degrades to an
# in-process cache and a per-instance rate limiter if this is unreachable.
REDIS_URL=redis://127.0.0.1:6379

# Max simultaneous upstream calls to X.
UPSTREAM_CONCURRENCY=8

# How long a cached profile stays fresh (ms). Default 15 minutes.
# Entries outlive this to remain available as a stale fallback when X is down.
CACHE_TTL_MS=900000

# Per-IP request cap per 15 min. Distinct from the token bucket: this protects
# the proxy from one noisy client; the bucket protects the shared X API budget.
IP_RATE_LIMIT=300

# Allowed CORS origin. Lock this to your extension ID in production.
CORS_ORIGIN=*
